# Скопировать в .env и заполнить реальными значениями. .env не коммитить.
# Секреты и параметры, которых нет в config.yaml.

# Веб-интерфейс: ключ подписи сессий.
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
WEB_SECRET_KEY=

# Telegram-бот (Шаг 10).
TELEGRAM_BOT_TOKEN=
# Необязательно: свой прокси/стаб Bot API (для разработки и тестов).
TELEGRAM_API_BASE=

# MAX (Шаг 14; API уточняется, по умолчанию канал недоступен).
MAX_API_BASE_URL=
MAX_API_TOKEN=

# Скрипт create_first_admin.py (Шаг 3), env-режим:
FIRST_ADMIN_LOGIN=admin
FIRST_ADMIN_PASSWORD=
FIRST_ADMIN_FULL_NAME=
FIRST_ADMIN_EMAIL=
